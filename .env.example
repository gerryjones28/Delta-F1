# ---------------------------------------------------------------------------
# DeltaTrace - example environment file
#
# Copy this file to .env and fill in your own local values:
#     Copy-Item .env.example .env
#
# .env is ignored by Git. Never commit real credentials.
# These are placeholders only; no schema has been designed yet.
# ---------------------------------------------------------------------------

# --- PostgreSQL connection (placeholders) ----------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deltatrace
POSTGRES_USER=deltatrace_app
POSTGRES_PASSWORD=replace_me_with_local_password

# Optional single-connection-string form for SQLAlchemy.
# Keep one style only, so configuration stays predictable.
# DATABASE_URL=postgresql+psycopg://deltatrace_app:replace_me_with_local_password@localhost:5432/deltatrace

# --- OpenF1 API -------------------------------------------------------------
# Historical data (2023 onwards) needs no authentication.
# Real-time data requires a paid subscription - not used in this project.
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_TIMEOUT=30

# --- F1DB local CSV directory ----------------------------------------------
# Relative paths are resolved from the project root.
# Point this at a local clone/export of https://github.com/f1db/f1db
F1DB_DATA_DIR=data/raw/f1db
